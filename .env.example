# NawGate local/demo configuration
#
# Copy this file to .env, fill APP_AUTH_TOKEN and exactly one model-provider
# section, then load it before running the POC:
#
#   cp .env.example .env
#   set -a
#   source .env
#   set +a
#   npm run poc
#
# Never commit .env. It is intentionally ignored by Git.

# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info

# Required by `npm run poc` because it listens beyond loopback. Generate a
# URL-safe value with `openssl rand -hex 24`, paste it here, and enter the same
# value in the browser unlock screen.
APP_AUTH_TOKEN=

# Choose exactly one model provider. Ark remains the backward-compatible
# default. To use OpenAI or another compatible provider, change this value to
# `openai-compatible` and fill the OPENAI_* section instead.
MODEL_PROVIDER=ark

# Option A: Volcengine Ark. Used only when MODEL_PROVIDER=ark.
# ARK_MODEL must be a Responses-capable endpoint/model ID, such as ep-xxxxxxxx.
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Option B: OpenAI or another provider exposing an OpenAI-compatible Responses
# API. Used only when MODEL_PROVIDER=openai-compatible.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Host path overrides are optional. Leave them commented for `npm run poc` so
# the startup script selects safe macOS/Linux locations automatically. Docker
# Compose injects its own /app paths inside the application container.
# APP_DATA_DIR=.local/data
# AGENT_WORKSPACE_ROOT=.local/workspaces
# CODEX_HOME=.local/codex-home

# CODEX_BIN is needed only by the host local-process profile (`npm run dev`).
# It is already installed in the POC and application container images.
# macOS example:
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
# Linux example:
# CODEX_BIN=/usr/local/bin/codex

# The current Agent Runtime adapter is Codex CLI. This is independent of
# MODEL_PROVIDER: Codex may call either Ark or an OpenAI-compatible endpoint.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Leave the gateway URL commented for normal use. `npm run poc` selects
# host.docker.internal or host.containers.internal for its disposable Runtime;
# direct local development defaults to http://127.0.0.1:<PORT>.
# NAWGATE_GATEWAY_URL=http://127.0.0.1:3000

# Approval polling must finish before the overall Codex timeout.
NAWGATE_APPROVAL_WAIT_MS=90000

# Judge/demo-only backend Security Lab. Set this to false outside an intentional
# local or protected demonstration environment.
NAWGATE_SECURITY_LAB_ENABLED=true

# Direct server and Docker Compose default to local-process. `npm run poc`
# overrides this to `container`, which is required for the complete Playground
# protected-action demo.
RUNTIME_PROVIDER=local-process

# Leave CONTAINER_ENGINE commented to auto-detect Docker, Colima (Docker CLI),
# or Podman. Uncomment only to force an installed and running engine.
# CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local

# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=

# Optional extra Runtime tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES="ca-certificates git ripgrep"
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256

# Leave these commented for the POC defaults. The startup script creates a
# repository/user-specific Runtime instance ID and uses the host UID:GID.
# RUNTIME_INSTANCE_ID=custom-demo
# CONTAINER_USER=1000:1000

# Optional single location for all POC state. When unset, macOS uses
# ~/.volc-agent-launchpad and Linux uses .local in the repository.
# LOCAL_POC_DATA_ROOT=.local
