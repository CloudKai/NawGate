  "cards": [
    {
      "dot": "violet",
      "title": "Human ≠ Agent ≠ Run",
      "items": [
        "Human identity comes from the browser session.",
        "Agent ownership is resolved by the backend.",
        "Each Run receives its own temporary runtime identity."
      ]
    },
    {
      "dot": "cyan",
      "title": "Effective protected-action authority",
      "items": [
        "Human team membership ∩ persistent Agent grant ∩ active Run identity",
        "∩ resource requirements ∩ exact JIT capability when required"
      ]
    },
    {
      "dot": "amber",
      "title": "Bouncer v4 policy",
      "items": [
        "Internal Team Alpha read with a valid viewer grant → ALLOW.",
        "Restricted Team Alpha read for viewer → REQUIRE_APPROVAL.",
        "Cross-user/team, missing or revoked authority, replay, forged or unknown input → DENY.",
        "Approval never overrides a hard DENY."
      ]
    },
    {
      "dot": "emerald",
      "title": "One-use JIT and revocation",
      "items": [
        "Owner approval creates an exact action/resource/Run-bound capability.",
        "The persistent Agent grant remains viewer after the one allowed read.",
        "Before the side effect, RuntimeGateway rechecks mutable authority; a revoked queued request executes nothing."
      ]
    },
    {
      "dot": "slate",
      "title": "Evidence and honest scope",
      "items": [
        "Audit and Delegation Receipt contain safe metadata, never credentials or protected payloads.",
        "Security Lab is a local/demo verification route through the real gateway.",
        "AgentGate protects registered agentctl actions, not every Codex shell, file, or network operation."
      ]
    }
  ]
