      { "id": "decision-approval", "label": "Decision and approval", "focus": ["gateway", "authority", "store", "human", "web"], "note": "bouncer-v5 and risk-v1 decide from backend facts. Critical actions require distinct owner and independent-reviewer slots." },
      { "id": "recheck-replay", "label": "Final recheck and replay", "focus": ["control", "gateway", "authority", "store", "action", "runtime"], "note": "The one-use claim is consumed, mutable authority is checked again next to the side effect, and an exact replay cannot execute twice." }
